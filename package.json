{
  "name": "@notebook/root",
  "private": true,
  "description": "Notebook: a personal Today page and customizable Spaces, synced with Google Calendar and Google Drive, delivered as an installable web app.",
  "packageManager": "pnpm@10.28.0",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=@notebook/web",
    "build": "turbo run build",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "lint": "turbo run lint",
    "lint:md": "markdownlint-cli2",
    "affected": "turbo run lint type-check test build --affected",
    "validate:deps": "depcruise --config .dependency-cruiser.cjs apps packages",
    "skills:setup:claude": "node scripts/manage-agent-skills.mjs --setup-claude",
    "skills:validate": "node scripts/manage-agent-skills.mjs --validate"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "markdownlint-cli2": "^0.24.0",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
